{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pt-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pt-tracker.stackmoth.com", "custom_domain": true }],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pt-tracker",
      // Filled in by scripts/setup.mjs after `wrangler d1 create pt-tracker`.
      "database_id": "53700781-9ddf-4c3e-9b21-26d7fe6d4e80",
      "migrations_dir": "migrations"
    }
  ],
  // Safety net: re-read the whole sheet and retry unsent app edits every 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Settings live in Worker secrets (this repo is public). `node scripts/setup.mjs` sets them:
  //   SHEET_SCRIPT_URL    the Apps Script web app /exec URL
  //   SHEET_SECRET        same value as the script's SHARED_SECRET property (setup() logs it)
  //   ACCESS_TEAM_DOMAIN  e.g. yourteam.cloudflareaccess.com
  //   ACCESS_AUD          the Access application's AUD tag
  //   ALLOWED_EMAILS      comma-separated emails allowed in (on top of the Access policy)
  //   SHEET_URL           link to the Google Sheet (for the "Open sheet" button)
  //   DISPLAY_NAMES       optional, "email=Name,email=Name" for the greeting
  "observability": { "enabled": true }
}
